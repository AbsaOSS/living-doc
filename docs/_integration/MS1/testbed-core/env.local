# First milestone: the runner's run over the public testbed's `core`, at the testbed's `master` and every component at
# its pin. Copied to tests/integration/.env.local before the run. The runner clones the components and the testbed
# itself and configures `core` as the CI testbed stage does (tests/testbed/run-testbed-stage.sh). Relative paths
# resolve against the living-doc checkout (see docs/_integration/README.md § Run a milestone target).
TARGET=testbed
TESTBED_REF=
COLLECTOR_GH_REF=
TOOLKIT_REF=
GENERATOR_MARKDOWN_REF=
OUT_DIR=docs/_integration/MS1/testbed-core
# Empty tries python3, then python. On Git Bash for Windows, python3 may be the Microsoft Store alias: set
# PYTHON=python.
PYTHON=

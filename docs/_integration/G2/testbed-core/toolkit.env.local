# Toolkit gate: the toolkit's run over the two files the collector wrote for the public testbed's `core`.
# Copied to living-doc-toolkit/.env.local before the run.
# Relative paths resolve against the toolkit's checkout, with living-doc and living-doc-toolkit
# cloned side by side (see docs/_integration/README.md § Before the first run).
DOC_INPUT=../living-doc/docs/_integration/G2/testbed-core/collector-gh/doc-source/doc-source.json
TESTS_INPUT=../living-doc/docs/_integration/G2/testbed-core/collector-gh/ui-tests/ui-tests.json
VIEW=inner
OUT_DIR=../living-doc/docs/_integration/G2/testbed-core
PYTHON=

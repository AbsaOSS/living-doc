# G1 run over the public testbed's `core`, the same configuration as the CI testbed stage
# (tests/testbed/run-testbed-stage.sh). Copied to living-doc-collector-gh/.env.local before the run.
# Relative paths resolve against the collector's checkout, with living-doc, living-doc-collector-gh and
# living-doc-testbed cloned side by side (see docs/_integration/README.md § Before the first run).
PROJECT_ID=testbed-core
TARGET_CHECKOUT=../living-doc-testbed
ORGANIZATION_NAME=AbsaOSS
REPOSITORY_NAME=living-doc-testbed
DOC_SOURCE_US_PATHS=projects/core/tests/e2e/features/liv_doc_us
DOC_SOURCE_FUNC_PATHS=projects/core/tests/e2e/features/liv_doc_func
DOC_SOURCE_PAGES_PATHS=projects/core/tests/e2e/pages
# The whole test tree, as CI reads it, so `smoke/` is read too: 28 scenarios, 2 of them outside living doc.
UI_TESTS_PATHS=projects/core/tests/e2e/features
GITHUB_SERVER_URL=
OUT_DIR=../living-doc/docs/_integration/G1/testbed-core
PYTHON=

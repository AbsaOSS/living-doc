# Release go/no-go: the runner's run over the public testbed's `core`, at the commits the release will tag. Fill each
# ref with a full 40-hex commit SHA, then copy this file to tests/integration/.env.local before the run. The runner
# clones the components and the testbed itself and configures `core` as the CI testbed stage does
# (tests/testbed/run-testbed-stage.sh). Relative paths resolve against the living-doc checkout (see
# docs/_integration/README.md § Release go/no-go).
TARGET=testbed
# The testbed's `master`, as a full commit SHA: git ls-remote https://github.com/AbsaOSS/living-doc-testbed master
TESTBED_REF=6b9b3ec9262032518023a3cd6e9f86acf97d1f89
# The living-doc-collector-gh candidate: the full SHA of its `master` once its release pull request merged. An empty
# ref runs the pin in tests/collector/collector-pins.env, which is no candidate.
COLLECTOR_GH_REF=3219c9350e96d463a456e4384b4a58a117926233
# The living-doc-toolkit candidate: the full SHA of its `master` once its release pull request merged.
TOOLKIT_REF=85e94232ba3294a1c8f86644ebe56d65b9d94a20
# The living-doc-generator-markdown candidate: the full SHA of its `master` once its release pull request merged.
GENERATOR_MARKDOWN_REF=d0e8b49cdaf9b6892327f8849742736408baeda3
# The release of the testbed's `core` content the run reads, which the operator names; not living-doc's version. The
# release view's documents carry it in their file names.
RELEASE_VERSION=0.1.0
OUT_DIR=docs/_integration/go-no-go/testbed-core
# Empty tries python3, then python. On Git Bash for Windows, python3 may be the Microsoft Store alias: set
# PYTHON=python.
PYTHON=
# Empty: the pin report is strict, as the go/no-go must be.
PIN_REPORT=

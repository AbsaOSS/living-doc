# Release milestone: the runner's run over the public testbed's `core`, with every component at its released tag.
# Copied to tests/integration/.env.local before the run. The runner clones the components and the testbed itself and
# configures `core` as the CI testbed stage does (tests/testbed/run-testbed-stage.sh). Relative paths resolve against
# the living-doc checkout (see docs/_integration/README.md § Run a milestone target).
TARGET=testbed
# The testbed commit the release go/no-go read (go-no-go/testbed-core/env.local), so the documents' source permalinks
# compare byte for byte with its run even after the testbed's `master` moves.
TESTBED_REF=6b9b3ec9262032518023a3cd6e9f86acf97d1f89
# Each component at the tag `living-doc` v0.2.0 lists, the same tags tests/collector/collector-pins.env pins.
COLLECTOR_GH_REF=v0.3.0
TOOLKIT_REF=v0.2.0
GENERATOR_MARKDOWN_REF=v0.2.0
# The release of the testbed's `core` content the run reads, as in the go/no-go; not living-doc's version.
RELEASE_VERSION=0.1.0
OUT_DIR=docs/_integration/MS4/testbed-core
# Empty tries python3, then python. On Git Bash for Windows, python3 may be the Microsoft Store alias: set
# PYTHON=python.
PYTHON=python
# Empty: the pin report is strict, as every milestone must be.
PIN_REPORT=

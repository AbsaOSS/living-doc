# Python
__pycache__/
*.py[cod]
.pytest_cache/

# The per-component venvs tests/collector/collector-gh.sh builds and reuses.
.snapshot-venvs/

# tests/integration/local-integration.sh: its configuration (the committed .env.local.example stays tracked), its
# clones of the components and the testbed (out/components/, out/testbed/) and its default output roots
# (out/<run-id>/).
tests/integration/.env.local
/out/

# Local planning workspace — spec drafts, issue drafts, local tools. Never shipped.
specs/

# macOS AppleDouble sidecar files
._*

# Agentic-layer eval runs — regenerable evidence (hundreds of answer/timing/grading files
# per iteration). Only the distilled result is tracked, in agentic/docs/testing/baseline.md.
agentic-evals-workspace/

# Claude Code project settings (the approved-command allowlist); kept local, not committed.
.claude/settings.json

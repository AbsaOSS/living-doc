# The configuration of tests/integration/local-integration.sh. Copy it to tests/integration/.env.local (git-ignored)
# and set TARGET. Read as data, never sourced: one KEY=value per line, `#` comments, no expansion; a line with any
# other key stops the run. A relative path resolves against this repository's root. How to run a milestone with it:
# docs/_integration/README.md § Run a milestone target.

# What the chain reads: `testbed` (living-doc-testbed's `core`, cloned by the runner) or `project` (a checkout on this
# machine, set by the project keys below).
TARGET=testbed

# The living-doc-testbed commit TARGET=testbed reads: a tag or a full commit SHA. Empty reads `master`.
TESTBED_REF=

# The living-doc-collector-gh ref: a tag or a full commit SHA. Empty runs the pin in tests/collector/collector-pins.env.
COLLECTOR_GH_REF=
# The living-doc-toolkit ref: a tag or a full commit SHA. Empty runs the pin.
TOOLKIT_REF=
# The living-doc-generator-markdown ref: a tag or a full commit SHA. Empty runs the pin.
GENERATOR_MARKDOWN_REF=

# --- TARGET=project only: the collector's settings, empty for the testbed --------------------------------------------
# The project's label in every artifact: lowercase letters, digits and hyphens. For an internal repository, a label
# that names no repository, such as absa-1. Required.
PROJECT_ID=
# The project's checkout on this machine. Required.
TARGET_CHECKOUT=
# The checkout's GitHub organization. Required.
ORGANIZATION_NAME=
# The checkout's repository name on the server. Required.
REPOSITORY_NAME=
# The User Story folders, relative to TARGET_CHECKOUT, comma-separated. Required.
DOC_SOURCE_US_PATHS=
# The Functionality folders, relative to TARGET_CHECKOUT, comma-separated.
DOC_SOURCE_FUNC_PATHS=
# The Feature PageObject folders (`.ts`), relative to TARGET_CHECKOUT, comma-separated.
DOC_SOURCE_PAGES_PATHS=
# The scenario folders `ui-tests` reads, relative to TARGET_CHECKOUT, comma-separated. Required.
UI_TESTS_PATHS=
# Empty for github.com; the server's URL for GitHub Enterprise Server.
GITHUB_SERVER_URL=

# --- Every target ---------------------------------------------------------------------------------------------------
# The output root. Empty writes out/<run-id>/ (git-ignored), the run id a UTC timestamp. A milestone run names its
# folder, for example docs/_integration/<milestone>/testbed-core. Never inside TARGET_CHECKOUT, out/testbed/ or
# out/components/: the run would write into a checkout it reads, or a later clean would delete the output.
OUT_DIR=
# The interpreter every component builds its venv from, Python 3.10 or later. Empty tries python3, then python. On Git
# Bash for Windows, python3 may be the Microsoft Store alias, which does not run: set PYTHON=python.
PYTHON=
